# ====================================================================
# KAISHA FACTORY APS - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env hoặc .env.local và điền các giá trị bảo mật
# LƯU Ý: Tuyệt đối KHÔNG commit file .env chứa mật khẩu thật lên GitHub!
# ====================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DB_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factory_aps
DB_USER=factory_admin
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://factory_admin:your_secure_password_here@localhost:5432/factory_aps

# Connection Pool Settings
POOL_MIN_CONN=2
POOL_MAX_CONN=20
POOL_TIMEOUT_SEC=10.0

# Authentication & Security
# Thay đổi khóa bí mật này bằng chuỗi ngẫu nhiên dài và an toàn trong môi trường sản xuất
AUTH_SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production
SESSION_EXPIRY_SECONDS=604800

# Frontend Configuration (Vite)
VITE_APP_TITLE=APS Brain Manufacturing Execution System
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCK=false
