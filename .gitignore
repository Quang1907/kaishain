# ====================================================================
# 1. BẢO MẬT & THÔNG TIN NHẠY CẢM (Security & Secrets)
# ====================================================================
# Môi trường & Khóa bí mật (Environment variables & Secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
# Ngoại lệ: Cho phép file mẫu cấu hình không chứa mật khẩu thực tế
!.env.example
!.env.template

# Khóa bảo mật, chứng chỉ (Keys, Certificates, Tokens)
*.pem
*.key
*.pub
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
token.json
credentials.json
client_secret*.json
service-account*.json
*.htpasswd

# Cloud credentials
.aws/
.gcp/
.azure/

# ====================================================================
# 2. PYTHON & BACKEND
# ====================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Môi trường ảo (Virtual Environments)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Phân phối / Đóng gói (Distribution / Packaging)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover

# Static analysis & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ====================================================================
# 3. NODE / FRONTEND (Vite, React, TypeScript)
# ====================================================================
node_modules/
dist/
build/
out/
.next/

# TypeScript Cache (Tránh commit cache build)
*.tsbuildinfo
frontend/*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# Framework cache
.eslintcache
.stylelintcache
.turbo/
.cache/
.vite/

# ====================================================================
# 4. DATABASE & RUNTIME DATA (Dữ liệu cục bộ & Backup)
# ====================================================================
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
postgres_data/
pgdata/
redis_data/

# Database dumps & Backups
*.dump
*.sql.gz
*.bak
*.backup

# ====================================================================
# 5. LOGS & FILE TẠM (Logs & Temp Files)
# ====================================================================
*.log
logs/
temp/
tmp/

# ====================================================================
# 6. HỆ ĐIỀU HÀNH & TRÌNH SOẠN THẢO (OS & IDE)
# ====================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*.sublime-project
*.sublime-workspace
